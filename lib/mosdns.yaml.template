log:
  level: info

plugins:
  - tag: china_domains
    type: domain_set
    args:
      files:
        - /etc/mosdns/chinalist.txt

  # Domains named by smart-routing rules (built from the rules by the updater).
  # Only these are sent to the gateway; block targets are refused here.
  - tag: rule_domains
    type: domain_set
    args:
      files:
        - /etc/mosdns/rule-domains.txt

  - tag: rule_block_domains
    type: domain_set
    args:
      files:
        - /etc/mosdns/rule-block.txt

  # Explicit per-domain overrides managed by --proxy-domain. These are
  # evaluated before the rule domains and ChinaList for client networks only.
  - tag: override_direct_domains
    type: domain_set
    args:
      files:
        - /etc/mosdns/override-direct.txt

  - tag: override_proxy_domains
    type: domain_set
    args:
      files:
        - /etc/mosdns/override-proxy.txt

  - tag: override_block_domains
    type: domain_set
    args:
      files:
        - /etc/mosdns/override-block.txt

  - tag: remote_primary
    type: forward
    args:
      concurrent: 2
      upstreams:
__REMOTE_PRIMARY_UPSTREAMS__

  - tag: remote_secondary
    type: forward
    args:
      concurrent: 2
      upstreams:
__REMOTE_SECONDARY_UPSTREAMS__

  # China DNS race: concurrent query to all 4 domestic resolvers over UDP.
  - tag: local_primary_forward
    type: forward
    args:
      concurrent: 4
      upstreams:
__LOCAL_PRIMARY_UPSTREAMS__

  # China DNS TCP fallback: used when UDP race times out.
  - tag: local_secondary_forward
    type: forward
    args:
      concurrent: 4
      upstreams:
__LOCAL_SECONDARY_UPSTREAMS__

  # Overseas fallback for China DNS: activated when both UDP and TCP domestic
  # DNS fail.  Includes 22.22.22.22 as a built-in resilience address.
  - tag: local_overseas_fallback_forward
    type: forward
    args:
      concurrent: 3
      upstreams:
        - addr: 1.1.1.1:53
        - addr: 8.8.8.8:53
        - addr: 22.22.22.22:53

  - tag: local_primary
    type: sequence
    args:
      - exec: ecs 139.226.48.1
      - exec: $local_primary_forward

  - tag: local_secondary
    type: sequence
    args:
      - exec: ecs 139.226.48.1
      - exec: $local_secondary_forward

  - tag: local_overseas_fallback
    type: sequence
    args:
      - exec: $local_overseas_fallback_forward

  - tag: remote_fallback
    type: fallback
    args:
      primary: remote_primary
      secondary: remote_secondary
      threshold: 1000
      always_standby: true

  # China DNS: UDP race -> 150ms timeout -> TCP race -> overseas fallback.
  - tag: local_udp_tcp_fallback
    type: fallback
    args:
      primary: local_primary
      secondary: local_secondary
      threshold: 150
      always_standby: true

  - tag: local_fallback
    type: fallback
    args:
      primary: local_udp_tcp_fallback
      secondary: local_overseas_fallback
      threshold: 800
      always_standby: true

  - tag: remote_cache
    type: cache
    args:
      size: __CACHE_SIZE__
      lazy_cache_ttl: 300

  - tag: local_cache
    type: cache
    args:
      size: __CACHE_SIZE__
      lazy_cache_ttl: 300

  - tag: remote_resolve
    type: sequence
    args:
      - exec: $remote_cache
      - exec: $remote_fallback

  - tag: local_resolve
    type: sequence
    args:
      - exec: $local_cache
      - exec: $local_fallback

  # DNS service does not return AAAA records; clients use IPv4 only.
  # Client networks (CLIENT_CIDRS, public mobile ranges):
  #   domains named by a routing rule -> server IP (proxied, exit per rule);
  #   rule target block -> refused; everything else resolves normally and the
  #   phone connects directly (ChinaList -> local_resolve, other -> overseas).
  # GFWList is not used at all: only routing rules decide what is proxied.
  - tag: reject_aaaa
    type: sequence
    args:
      - matches:
          - qtype 28
        exec: reject 0

  - tag: proxy_client
    type: sequence
    args:
      # Explicit overrides take precedence over downloaded lists.
      - matches:
          - qname $override_block_domains
        exec: reject 0
      - matches:
          - qname $override_direct_domains
        exec: goto local_resolve
      - matches:
          - qname $override_proxy_domains
          - qtype 1
        exec: black_hole __SERVER_IP__
      - matches:
          - has_resp
        exec: accept
      - matches:
          - qname $rule_block_domains
        exec: reject 0
      - matches:
          - qname $rule_domains
          - qtype 1
        exec: black_hole __SERVER_IP__
      - matches:
          - has_resp
        exec: accept
      - matches:
          - qname $china_domains
        exec: goto local_resolve
      - exec: goto remote_resolve

  - tag: other_client
    type: sequence
    args:
      - matches:
          - qname $china_domains
        exec: goto local_resolve
      - exec: goto remote_resolve

  - tag: main_sequence
    type: sequence
    args:
      - exec: $reject_aaaa
      - matches:
          - has_resp
        exec: accept
      # dot-gate owns the public port and checks the DoT name; it relays
      # client-network connections from 127.0.0.2 (others from 127.0.0.3).
      - matches:
          - client_ip __CLIENT_CIDRS__ 127.0.0.2/32
        exec: goto proxy_client
      - exec: goto other_client

  - tag: dot_853
    type: tcp_server
    args:
      entry: main_sequence
      listen: "127.0.0.1:8853"
      cert: /etc/mosdns/certs/fullchain.pem
      key: /etc/mosdns/certs/privkey.pem
